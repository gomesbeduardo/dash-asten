// Histórico de cargas por competência (D28, D37). Prisma 7 + Neon (adaptador).
// O schema Postgres por ambiente (public = produção, staging = dev/preview) vem de DB_SCHEMA,
// aplicado no adaptador em runtime e na URL das migrações (db/prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../api/_generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Carga {
  id          String   @id @default(cuid(2))
  tipo        String
  competencia String   @db.Char(7)
  versao      Int
  importadaEm DateTime @default(now()) @map("importada_em") @db.Timestamptz(6)
  arquivo     String
  /// Nome dado pela pessoa (opcional; ex.: "Correção do Líder"). D58.
  nome        String?
  /// Carga arquivada: some das listas por padrão, nada é apagado; null = ativa. D58.
  arquivadaEm DateTime? @map("arquivada_em") @db.Timestamptz(6)
  /// Mes Ref. lido da planilha no envio (AAAA-MM), para auditoria quando a competência foi editada. D63.
  mesRef      String?   @map("mes_ref") @db.Char(7)
  linhas      Int
  /// Workbook normalizado (abas, colunas, linhas); datas em ISO 8601.
  dados       Json
  /// .xlsx original, para reprocessar se o leitor ou as regras mudarem.
  original    Bytes?

  // O índice único também atende as listagens por (tipo, competência, versão): o B-tree é lido nos dois sentidos.
  // CHECKs de formato ficam na migração 0004 (o Prisma não modela CHECK).
  @@unique([tipo, competencia, versao])
  @@map("cargas")
}
